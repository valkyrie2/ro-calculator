{
  "name": "ro-calculator",
  "version": "1.0.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve  --host 0.0.0.0 --hmr --port 4200",
    "start2": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "validate": "npm run lint && npm run typecheck && npm run test:ci",
    "e2e": "ng e2e",
    "predeploy": "ng build --output-hashing all --output-path docs --base-href /",
    "deploy": "copy docs\\index.html docs\\404.html",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,html}": "eslint --fix",
    "*.{json,md,scss,css}": "prettier --write"
  },
  "private": true,
  "overrides": {
    "serialize-javascript": "7.0.5",
    "tar": "7.5.15"
  },
  "dependencies": {
    "@angular/animations": "~19.2.22",
    "@angular/cdk": "~19.2.19",
    "@angular/common": "~19.2.22",
    "@angular/compiler": "~19.2.22",
    "@angular/core": "~19.2.22",
    "@angular/forms": "~19.2.22",
    "@angular/platform-browser": "~19.2.22",
    "@angular/platform-browser-dynamic": "~19.2.22",
    "@angular/router": "~19.2.22",
    "@fullcalendar/angular": "^6.0.3",
    "@fullcalendar/core": "^6.0.3",
    "@fullcalendar/daygrid": "^6.0.3",
    "@fullcalendar/interaction": "^6.0.3",
    "@fullcalendar/timegrid": "^6.0.3",
    "@primeng/themes": "~19.1.4",
    "@supabase/supabase-js": "~2.104.1",
    "chart.js": "^3.3.2",
    "js-yaml": "~4.1.1",
    "primeflex": "^3.3.1",
    "primeicons": "6.0.1",
    "primeng": "~19.1.4",
    "prismjs": "^1.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "~3.25.76",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~19.2.26",
    "@angular-eslint/builder": "~19.8.1",
    "@angular-eslint/eslint-plugin": "~19.8.1",
    "@angular-eslint/eslint-plugin-template": "~19.8.1",
    "@angular-eslint/schematics": "~19.8.1",
    "@angular-eslint/template-parser": "~19.8.1",
    "@angular/cli": "~19.2.26",
    "@angular/compiler-cli": "~19.2.22",
    "@types/jasmine": "~4.3.0",
    "@types/node": "~18.19.130",
    "@typescript-eslint/eslint-plugin": "~8.59.3",
    "@typescript-eslint/parser": "~8.59.3",
    "eslint": "~8.57.1",
    "eslint-plugin-unused-imports": "~4.4.1",
    "husky": "~9.1.7",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "~16.4.0",
    "prettier": "~3.8.3",
    "supabase": "~2.95.3",
    "typescript": "~5.8.3"
  }
}
